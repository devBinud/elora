rules_version = '2';

// Elora Cloud Storage Security Rules
// - users/{uid}/...  private files (journal attachments, backups), owner only.
// - public/...       app-wide assets, readable by signed-in users, written by
//                    admins via the console or Cloud Functions only.

service firebase.storage {
  match /b/{bucket}/o {

    match /users/{userId}/{allPaths=**} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 20 * 1024 * 1024;
    }

    match /public/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
