# Copy this file to `.env` and fill in values from
# Firebase console -> Project settings -> General -> Your apps -> Web app config.
# EXPO_PUBLIC_* values are bundled into the app. Firebase web config is not
# secret; access is enforced by Firestore/Storage security rules and App Check.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Region your Cloud Functions are deployed to.
EXPO_PUBLIC_FIREBASE_FUNCTIONS_REGION=asia-south1

# Build-time only (not bundled into the app).
ELORA_ANDROID_PACKAGE=com.elora.assistant
EAS_PROJECT_ID=

# Development only: route Firebase traffic through `npm run proxy` (scripts/api-proxy.js)
# on the PC running Metro. Use when the phone reaches the PC but not Google's servers.
# EXPO_PUBLIC_DEV_PROXY=on
# EXPO_PUBLIC_DEV_PROXY_PORT=8787
# EXPO_PUBLIC_DEV_PROXY_HOST=192.168.1.72:8787   # optional; defaults to the Metro host

# GNews API key for the News tab (https://gnews.io/dashboard). Bundled into the app,
# so treat it as a dev/personal key; move calls to a Cloud Function before release.
EXPO_PUBLIC_GNEWS_API_KEY=
